      },
      "data": {}
    },
    {
      "id": "obsidian-minimal-settings",
      "name": "Minimal Theme Settings",
      "repo": "kepano/obsidian-minimal-settings",
      "version": "9.0.0",
      "desktop_only": false,
      "assets": {
        "main.js": "edbf3c7a97281848ec42537699e9b093d72bf608d37eaaf4033635b609825752",
        "manifest.json": "62483a077feaa283049683d4f28ef58dad3d7811e4c343593b87bbd8bb4a2957",
        "styles.css": "33258afcd002718bc1a941b1024f3c2b1fcff73d62a93411e9e0ceea4117879a"
      },
      "data": {}
    }
