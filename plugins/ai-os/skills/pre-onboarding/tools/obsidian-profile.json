{
  "profile_version": 1,
  "about": "The editor setup the method ships (wiki-maintenance, The editor setup). obsidian.py builds .obsidian/ from it: each plugin's three release assets are fetched from GitHub at the pinned version and verified against these hashes; its data is written as data.json. Upgrading a plugin is a change here and a MINOR release.",
  "core_plugins": [
    "file-explorer",
    "global-search",
    "switcher",
    "graph",
    "backlink",
    "canvas",
    "outgoing-link",
    "tag-pane",
    "properties",
    "page-preview",
    "daily-notes",
    "templates",
    "note-composer",
    "command-palette",
    "editor-status",
    "bookmarks",
    "outline",
    "word-count",
    "file-recovery",
    "sync",
    "bases"
  ],
  "app": {
    "alwaysUpdateLinks": true
  },
  "appearance": {},
  "never": [
    "workspace.json",
    "workspaces.json",
    "graph.json",
    "page-preview.json"
  ],
